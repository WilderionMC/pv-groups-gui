<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">
    <components>
        <flow-layout direction="vertical">
            <children>
                <stack-layout id="views">
                    <children>
                        <!-- MAIN: browse groups -->
                        <flow-layout direction="vertical" id="view-main">
                            <children>
                                <label id="main-title">
                                    <text translate="true">pv.addon.groups.gui.title.main</text>
                                    <shadow>true</shadow>
                                    <color>#FFFFFF</color>
                                </label>

                                <label id="main-status">
                                    <color>#FFAA55</color>
                                    <horizontal-text-alignment>center</horizontal-text-alignment>
                                </label>

                                <flow-layout direction="horizontal" id="main-header-actions">
                                    <children>
                                        <button id="open-create-button">
                                            <text translate="true">pv.addon.groups.gui.button.create</text>
                                        </button>
                                        <button id="refresh-button">
                                            <text translate="true">pv.addon.groups.gui.button.refresh</text>
                                        </button>
                                    </children>
                                    <gap>6</gap>
                                    <horizontal-alignment>center</horizontal-alignment>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                </flow-layout>

                                <label>
                                    <text translate="true">pv.addon.groups.gui.section.groups</text>
                                    <color>#8A8A8A</color>
                                </label>

                                <scroll direction="vertical" id="groups-scroll">
                                    <flow-layout direction="vertical" id="groups-list">
                                        <children/>
                                        <gap>3</gap>
                                        <sizing>
                                            <horizontal method="fill">100</horizontal>
                                        </sizing>
                                    </flow-layout>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                        <vertical method="expand">100</vertical>
                                    </sizing>
                                    <padding>
                                        <all>4</all>
                                    </padding>
                                    <surface>
                                        <panel-inset/>
                                    </surface>
                                </scroll>

                                <text-box id="join-password-field">
                                    <max-length>64</max-length>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                    <margins>
                                        <top>4</top>
                                    </margins>
                                </text-box>

                                <button id="join-button">
                                    <text translate="true">pv.addon.groups.gui.button.join</text>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                    <margins>
                                        <top>4</top>
                                    </margins>
                                </button>
                            </children>

                            <gap>4</gap>
                            <padding>
                                <all>10</all>
                            </padding>
                            <horizontal-alignment>center</horizontal-alignment>
                            <sizing>
                                <horizontal method="fill">100</horizontal>
                                <vertical method="fill">100</vertical>
                            </sizing>
                            <surface>
                                <panel dark="true"/>
                            </surface>
                        </flow-layout>

                        <!-- CREATE: popup form -->
                        <flow-layout direction="vertical" id="view-create">
                            <children>
                                <label id="create-title">
                                    <text translate="true">pv.addon.groups.gui.title.create</text>
                                    <shadow>true</shadow>
                                    <color>#FFFFFF</color>
                                </label>

                                <label id="create-status">
                                    <color>#FFAA55</color>
                                    <horizontal-text-alignment>center</horizontal-text-alignment>
                                </label>

                                <text-box id="name-field">
                                    <max-length>32</max-length>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                </text-box>

                                <text-box id="password-field">
                                    <max-length>64</max-length>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                </text-box>

                                <button id="create-persistent-button">
                                    <text translate="true">pv.addon.groups.gui.button.persistent_off</text>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                </button>

                                <text-box id="create-permissions-field">
                                    <max-length>256</max-length>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                </text-box>

                                <flow-layout direction="horizontal" id="create-actions">
                                    <children>
                                        <button id="create-button">
                                            <text translate="true">pv.addon.groups.gui.button.create</text>
                                        </button>
                                        <button id="create-back-button">
                                            <text translate="true">pv.addon.groups.gui.button.back</text>
                                        </button>
                                    </children>
                                    <gap>6</gap>
                                    <horizontal-alignment>center</horizontal-alignment>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                    <margins>
                                        <top>6</top>
                                    </margins>
                                </flow-layout>
                            </children>

                            <gap>6</gap>
                            <padding>
                                <all>12</all>
                            </padding>
                            <horizontal-alignment>center</horizontal-alignment>
                            <sizing>
                                <horizontal method="fill">100</horizontal>
                                <vertical method="fill">100</vertical>
                            </sizing>
                            <surface>
                                <panel dark="true"/>
                            </surface>
                        </flow-layout>

                        <!-- GROUP: members + manage -->
                        <flow-layout direction="vertical" id="view-group">
                            <children>
                                <label id="group-title">
                                    <shadow>true</shadow>
                                    <color>#FFFFFF</color>
                                </label>

                                <label id="group-subtitle">
                                    <color>#A0A0A0</color>
                                    <horizontal-text-alignment>center</horizontal-text-alignment>
                                </label>

                                <label id="group-status">
                                    <color>#FFAA55</color>
                                    <horizontal-text-alignment>center</horizontal-text-alignment>
                                </label>

                                <scroll direction="vertical" id="members-scroll">
                                    <flow-layout direction="vertical" id="members-list">
                                        <children/>
                                        <gap>2</gap>
                                        <sizing>
                                            <horizontal method="fill">100</horizontal>
                                        </sizing>
                                    </flow-layout>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                        <vertical method="expand">100</vertical>
                                    </sizing>
                                    <padding>
                                        <all>4</all>
                                    </padding>
                                    <surface>
                                        <panel-inset/>
                                    </surface>
                                </scroll>

                                <flow-layout direction="horizontal" id="overlay-actions">
                                    <children>
                                        <button id="overlay-toggle-button">
                                            <text>👁</text>
                                            <sizing>
                                                <horizontal method="fixed">20</horizontal>
                                            </sizing>
                                        </button>
                                        <button id="overlay-position-button">
                                            <text>⌖</text>
                                            <sizing>
                                                <horizontal method="fixed">20</horizontal>
                                            </sizing>
                                        </button>
                                        <button id="overlay-layout-button">
                                            <text>↔</text>
                                            <sizing>
                                                <horizontal method="fixed">20</horizontal>
                                            </sizing>
                                        </button>
                                    </children>
                                    <gap>4</gap>
                                    <horizontal-alignment>center</horizontal-alignment>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                    <margins>
                                        <top>4</top>
                                    </margins>
                                </flow-layout>

                                <flow-layout direction="horizontal" id="group-actions">
                                    <children>
                                        <flow-layout direction="horizontal" id="group-actions-left">
                                            <children>
                                                <button id="open-invite-button">
                                                    <text>+</text>
                                                    <sizing>
                                                        <horizontal method="fixed">20</horizontal>
                                                    </sizing>
                                                </button>
                                                <button id="open-transfer-button">
                                                    <text>🗡</text>
                                                    <sizing>
                                                        <horizontal method="fixed">20</horizontal>
                                                    </sizing>
                                                </button>
                                                <button id="open-settings-button">
                                                    <text>✎</text>
                                                    <sizing>
                                                        <horizontal method="fixed">20</horizontal>
                                                    </sizing>
                                                </button>
                                            </children>
                                            <gap>2</gap>
                                            <horizontal-alignment>left</horizontal-alignment>
                                            <sizing>
                                                <horizontal method="fixed">72</horizontal>
                                            </sizing>
                                        </flow-layout>
                                        <flow-layout direction="horizontal" id="group-actions-center">
                                            <children>
                                                <button id="all-groups-button">
                                                    <text translate="true">pv.addon.groups.gui.button.all_groups</text>
                                                </button>
                                            </children>
                                            <horizontal-alignment>center</horizontal-alignment>
                                            <sizing>
                                                <horizontal method="expand">100</horizontal>
                                            </sizing>
                                        </flow-layout>
                                        <flow-layout direction="horizontal" id="group-actions-right">
                                            <children>
                                                <button id="disband-button">
                                                    <text>×</text>
                                                    <sizing>
                                                        <horizontal method="fixed">20</horizontal>
                                                    </sizing>
                                                </button>
                                            </children>
                                            <horizontal-alignment>right</horizontal-alignment>
                                            <sizing>
                                                <horizontal method="fixed">24</horizontal>
                                            </sizing>
                                        </flow-layout>
                                    </children>
                                    <gap>0</gap>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                    <margins>
                                        <top>6</top>
                                    </margins>
                                </flow-layout>
                            </children>

                            <gap>4</gap>
                            <padding>
                                <all>10</all>
                            </padding>
                            <horizontal-alignment>center</horizontal-alignment>
                            <sizing>
                                <horizontal method="fill">100</horizontal>
                                <vertical method="fill">100</vertical>
                            </sizing>
                            <surface>
                                <panel dark="true"/>
                            </surface>
                        </flow-layout>

                        <!-- CONFIRM: destructive action popup -->
                        <flow-layout direction="vertical" id="view-confirm">
                            <children>
                                <label id="confirm-title">
                                    <shadow>true</shadow>
                                    <color>#FFFFFF</color>
                                    <horizontal-text-alignment>center</horizontal-text-alignment>
                                </label>

                                <label id="confirm-message">
                                    <color>#C8C8C8</color>
                                    <horizontal-text-alignment>center</horizontal-text-alignment>
                                </label>

                                <flow-layout direction="horizontal" id="confirm-actions">
                                    <children>
                                        <button id="confirm-yes-button">
                                            <text translate="true">pv.addon.groups.gui.button.confirm_yes</text>
                                        </button>
                                        <button id="confirm-no-button">
                                            <text translate="true">pv.addon.groups.gui.button.confirm_no</text>
                                        </button>
                                    </children>
                                    <gap>6</gap>
                                    <horizontal-alignment>center</horizontal-alignment>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                    <margins>
                                        <top>8</top>
                                    </margins>
                                </flow-layout>
                            </children>

                            <gap>8</gap>
                            <padding>
                                <all>12</all>
                            </padding>
                            <horizontal-alignment>center</horizontal-alignment>
                            <sizing>
                                <horizontal method="fill">100</horizontal>
                                <vertical method="fill">100</vertical>
                            </sizing>
                            <surface>
                                <panel dark="true"/>
                            </surface>
                        </flow-layout>

                        <!-- SETTINGS: rename / password -->
                        <flow-layout direction="vertical" id="view-settings">
                            <children>
                                <label id="settings-title">
                                    <text translate="true">pv.addon.groups.gui.title.settings</text>
                                    <shadow>true</shadow>
                                    <color>#FFFFFF</color>
                                </label>

                                <label id="settings-status">
                                    <color>#FFAA55</color>
                                    <horizontal-text-alignment>center</horizontal-text-alignment>
                                </label>

                                <text-box id="edit-name-field">
                                    <max-length>32</max-length>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                </text-box>

                                <text-box id="edit-password-field">
                                    <max-length>64</max-length>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                </text-box>

                                <button id="edit-persistent-button">
                                    <text translate="true">pv.addon.groups.gui.button.persistent_off</text>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                </button>

                                <text-box id="edit-permissions-field">
                                    <max-length>256</max-length>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                </text-box>

                                <flow-layout direction="horizontal" id="settings-actions">
                                    <children>
                                        <button id="save-settings-button">
                                            <text translate="true">pv.addon.groups.gui.button.save</text>
                                            <sizing>
                                                <horizontal method="expand">100</horizontal>
                                            </sizing>
                                        </button>
                                        <button id="remove-password-button">
                                            <text translate="true">pv.addon.groups.gui.button.remove_password</text>
                                            <sizing>
                                                <horizontal method="expand">100</horizontal>
                                            </sizing>
                                        </button>
                                    </children>
                                    <gap>6</gap>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                </flow-layout>

                                <button id="clear-permissions-button">
                                    <text translate="true">pv.addon.groups.gui.button.clear_permissions</text>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                </button>

                                <button id="settings-back-button">
                                    <text translate="true">pv.addon.groups.gui.button.back</text>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                    <margins>
                                        <top>4</top>
                                    </margins>
                                </button>
                            </children>

                            <gap>6</gap>
                            <padding>
                                <all>12</all>
                            </padding>
                            <horizontal-alignment>center</horizontal-alignment>
                            <sizing>
                                <horizontal method="fill">100</horizontal>
                                <vertical method="fill">100</vertical>
                            </sizing>
                            <surface>
                                <panel dark="true"/>
                            </surface>
                        </flow-layout>

                        <!-- TRANSFER: pick new owner -->
                        <flow-layout direction="vertical" id="view-transfer">
                            <children>
                                <label id="transfer-title">
                                    <text translate="true">pv.addon.groups.gui.title.transfer</text>
                                    <shadow>true</shadow>
                                    <color>#FFFFFF</color>
                                </label>

                                <label id="transfer-status">
                                    <color>#FFAA55</color>
                                    <horizontal-text-alignment>center</horizontal-text-alignment>
                                </label>

                                <text-box id="transfer-filter-field">
                                    <max-length>16</max-length>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                </text-box>

                                <scroll direction="vertical" id="transfer-scroll">
                                    <flow-layout direction="vertical" id="transfer-list">
                                        <children/>
                                        <gap>2</gap>
                                        <sizing>
                                            <horizontal method="fill">100</horizontal>
                                        </sizing>
                                    </flow-layout>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                        <vertical method="expand">100</vertical>
                                    </sizing>
                                    <padding>
                                        <all>4</all>
                                    </padding>
                                    <surface>
                                        <panel-inset/>
                                    </surface>
                                </scroll>

                                <flow-layout direction="horizontal" id="transfer-actions">
                                    <children>
                                        <button id="confirm-transfer-button">
                                            <text translate="true">pv.addon.groups.gui.button.confirm_transfer</text>
                                            <sizing>
                                                <horizontal method="expand">100</horizontal>
                                            </sizing>
                                        </button>
                                        <button id="transfer-back-button">
                                            <text translate="true">pv.addon.groups.gui.button.back</text>
                                            <sizing>
                                                <horizontal method="expand">100</horizontal>
                                            </sizing>
                                        </button>
                                    </children>
                                    <gap>6</gap>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                    <margins>
                                        <top>6</top>
                                    </margins>
                                </flow-layout>
                            </children>

                            <gap>4</gap>
                            <padding>
                                <all>10</all>
                            </padding>
                            <horizontal-alignment>center</horizontal-alignment>
                            <sizing>
                                <horizontal method="fill">100</horizontal>
                                <vertical method="fill">100</vertical>
                            </sizing>
                            <surface>
                                <panel dark="true"/>
                            </surface>
                        </flow-layout>

                        <!-- INVITE: client player list -->
                        <flow-layout direction="vertical" id="view-invite">
                            <children>
                                <label id="invite-title">
                                    <text translate="true">pv.addon.groups.gui.title.invite</text>
                                    <shadow>true</shadow>
                                    <color>#FFFFFF</color>
                                </label>

                                <label id="invite-status">
                                    <color>#FFAA55</color>
                                    <horizontal-text-alignment>center</horizontal-text-alignment>
                                </label>

                                <text-box id="invite-filter-field">
                                    <max-length>16</max-length>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                </text-box>

                                <scroll direction="vertical" id="invite-scroll">
                                    <flow-layout direction="vertical" id="invite-list">
                                        <children/>
                                        <gap>2</gap>
                                        <sizing>
                                            <horizontal method="fill">100</horizontal>
                                        </sizing>
                                    </flow-layout>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                        <vertical method="expand">100</vertical>
                                    </sizing>
                                    <padding>
                                        <all>4</all>
                                    </padding>
                                    <surface>
                                        <panel-inset/>
                                    </surface>
                                </scroll>

                                <flow-layout direction="horizontal" id="invite-actions">
                                    <children>
                                        <button id="confirm-invite-button">
                                            <text translate="true">pv.addon.groups.gui.button.confirm_invite</text>
                                            <sizing>
                                                <horizontal method="expand">100</horizontal>
                                            </sizing>
                                        </button>
                                        <button id="invite-back-button">
                                            <text translate="true">pv.addon.groups.gui.button.back</text>
                                            <sizing>
                                                <horizontal method="expand">100</horizontal>
                                            </sizing>
                                        </button>
                                    </children>
                                    <gap>6</gap>
                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                    <margins>
                                        <top>6</top>
                                    </margins>
                                </flow-layout>
                            </children>

                            <gap>4</gap>
                            <padding>
                                <all>10</all>
                            </padding>
                            <horizontal-alignment>center</horizontal-alignment>
                            <sizing>
                                <horizontal method="fill">100</horizontal>
                                <vertical method="fill">100</vertical>
                            </sizing>
                            <surface>
                                <panel dark="true"/>
                            </surface>
                        </flow-layout>
                    </children>

                    <sizing>
                        <horizontal method="fixed">320</horizontal>
                        <vertical method="fixed">280</vertical>
                    </sizing>
                </stack-layout>
            </children>

            <padding>
                <all>8</all>
            </padding>
            <horizontal-alignment>center</horizontal-alignment>
            <vertical-alignment>center</vertical-alignment>
            <sizing>
                <horizontal method="fill">100</horizontal>
                <vertical method="fill">100</vertical>
            </sizing>
        </flow-layout>
    </components>

    <templates>
        <template name="empty-label">
            <label>
                <text translate="true">{{key}}</text>
                <color>#808080</color>
                <margins>
                    <all>4</all>
                </margins>
            </label>
        </template>

        <template name="group-row">
            <flow-layout direction="vertical" id="group-row">
                <children>
                    <button id="group-pick-btn">
                        <text>{{label}}</text>
                        <sizing>
                            <horizontal method="fill">100</horizontal>
                        </sizing>
                    </button>
                    <scroll direction="horizontal" id="group-heads-scroll">
                        <flow-layout direction="horizontal" id="group-heads">
                            <children/>
                            <gap>2</gap>
                            <vertical-alignment>center</vertical-alignment>
                        </flow-layout>
                        <sizing>
                            <horizontal method="fill">100</horizontal>
                            <vertical method="fixed">22</vertical>
                        </sizing>
                        <scrollbar-thiccness>3</scrollbar-thiccness>
                        <padding>
                            <horizontal>2</horizontal>
                            <vertical>1</vertical>
                        </padding>
                    </scroll>
                </children>
                <gap>2</gap>
                <padding>
                    <all>2</all>
                </padding>
                <sizing>
                    <horizontal method="fill">100</horizontal>
                </sizing>
            </flow-layout>
        </template>

        <template name="member-row">
            <flow-layout direction="horizontal" id="member-row">
                <children>
                    <label id="member-name">
                        <text>{{name}}</text>
                        <color>#FFFFFF</color>
                        <sizing>
                            <horizontal method="expand">100</horizontal>
                        </sizing>
                    </label>
                    <button id="kick-btn">
                        <text>-</text>
                        <sizing>
                            <horizontal method="fixed">18</horizontal>
                        </sizing>
                    </button>
                    <button id="ban-btn">
                        <text>×</text>
                        <sizing>
                            <horizontal method="fixed">18</horizontal>
                        </sizing>
                    </button>
                </children>
                <gap>4</gap>
                <vertical-alignment>center</vertical-alignment>
                <padding>
                    <all>2</all>
                </padding>
                <sizing>
                    <horizontal method="fill">100</horizontal>
                    <vertical method="fixed">28</vertical>
                </sizing>
            </flow-layout>
        </template>

        <template name="banned-row">
            <flow-layout direction="horizontal" id="banned-row">
                <children>
                    <label id="banned-name">
                        <text>{{name}}</text>
                        <color>#AAAAAA</color>
                        <sizing>
                            <horizontal method="expand">100</horizontal>
                        </sizing>
                    </label>
                    <button id="unban-btn">
                        <text>+</text>
                        <sizing>
                            <horizontal method="fixed">18</horizontal>
                        </sizing>
                    </button>
                </children>
                <gap>4</gap>
                <vertical-alignment>center</vertical-alignment>
                <padding>
                    <all>2</all>
                </padding>
                <sizing>
                    <horizontal method="fill">100</horizontal>
                    <vertical method="fixed">28</vertical>
                </sizing>
            </flow-layout>
        </template>

        <template name="invite-row">
            <flow-layout direction="horizontal" id="invite-row">
                <children>
                    <button id="invite-pick-btn">
                        <text>{{name}}</text>
                        <sizing>
                            <horizontal method="expand">100</horizontal>
                        </sizing>
                    </button>
                </children>
                <gap>4</gap>
                <vertical-alignment>center</vertical-alignment>
                <padding>
                    <all>2</all>
                </padding>
                <sizing>
                    <horizontal method="fill">100</horizontal>
                    <vertical method="fixed">28</vertical>
                </sizing>
            </flow-layout>
        </template>
    </templates>
</owo-ui>
